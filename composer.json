{
    "name": "deniztezcan/laravel-postnl-api",
    "description": "Laravel PostNL API package",
    "type": "library",
    "license": "MIT",
    "version": "4.0.0",
    "homepage": "https://github.com/deniztezcan/laravel-postnl-api",
    "authors": [
        {
            "name": "Deniz Tezcan",
            "email": "howdy@deniztezcan.me"
        }
    ],
    "autoload": {
        "psr-4": { "DenizTezcan\\PostNL\\" : "src/" }
    },
    "minimum-stability": "stable",
    "require": {
        "guzzlehttp/guzzle": "^6.3|^7.0|^7.7|^7.8",
        "illuminate/support": "5.8.*|6.*.*|7.*.*|8.*.*|9.*.*|10.*.*|11.*.*",
        "nesbot/carbon": "^2.16"
    },
    "extra": {
      "laravel": {
        "providers": [
          "DenizTezcan\\PostNL\\PostNLServiceProvider"
        ],
        "aliases": {
          "PostNL": "DenizTezcan\\PostNL\\Facades\\PostNL"
        }
      }
    }
}
